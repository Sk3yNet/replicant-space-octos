{
    "name": "Replicant Space",
    "author": "sk3ynet",
    "description": "Version 1.4.0. Your Replicant Space galaxy and star systems as a live wallpaper: your systems, replicants, fleets, supply lines, relay range, ships in transit and stockpiles, from your own Replicant Space web client.",
    "entry": "index.html",
    "image": "image.png",
    "preview": "preview.png",
    "options": {
        "help": {
            "type": "description",
            "label": "Make a wallpaper link in your Replicant Space web client (Account › Desktop wallpaper) and paste it below. The running versions show in the wallpaper's bottom-right corner."
        },
        "link": {
            "type": "text",
            "label": "Wallpaper link",
            "value": ""
        },
        "view": {
            "type": "select",
            "label": "Show",
            "options": ["Galaxy", "One system", "Cycle my systems"],
            "value": "Galaxy"
        },
        "system": {
            "type": "text",
            "label": "System (for Galaxy: centre on it; for One system: which)",
            "value": ""
        },
        "labels": {
            "type": "checkbox",
            "label": "Show labels",
            "value": true
        },
        "cover": {
            "type": "checkbox",
            "label": "Show relay/hub range",
            "value": true
        },
        "fleets": {
            "type": "checkbox",
            "label": "Show fleets (where they are, what they're doing, where they're headed)",
            "value": true
        },
        "supply": {
            "type": "checkbox",
            "label": "Show supply lines (materials and trade routes between your fleets' systems)",
            "value": true
        },
        "production": {
            "type": "checkbox",
            "label": "Show mining sparkles (what each system is mining now, coloured by resource)",
            "value": true
        },
        "hud": {
            "type": "select",
            "label": "Dashboard panel (devices, stockpiles, fleets)",
            "options": ["Right", "Left", "Off"],
            "value": "Right"
        },
        "rotate": {
            "type": "range",
            "label": "Galaxy rotation speed",
            "min": 0,
            "max": 20,
            "step": 1,
            "value": 4
        },
        "refresh": {
            "type": "number",
            "label": "Refresh every (minutes)",
            "min": 1,
            "max": 120,
            "value": 5
        },
        "cycle": {
            "type": "number",
            "label": "Cycle: seconds per system",
            "min": 10,
            "max": 3600,
            "value": 60
        }
    }
}
